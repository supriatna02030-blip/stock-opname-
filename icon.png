@charset "utf-8";

* { font-family: Poppins, sans-serif; }

body { background: linear-gradient(135deg, rgb(79, 172, 254) 0%, rgb(0, 242, 254) 100%); display: flex; justify-content: center; align-items: center; min-height: 100vh; margin: 0px; padding: 15px; transition: 0.3s; }

body.dark { background: rgb(26, 26, 46); }

.container { background: white; padding: 25px; border-radius: 20px; width: 100%; max-width: 1200px; box-shadow: rgba(0, 0, 0, 0.2) 0px 10px 30px; }

body.dark.container { background: rgb(22, 33, 62); color: white; }

h2 { text-align: center; color: rgb(41, 128, 185); font-weight: 700; }

body.dark h2 { color: rgb(0, 242, 254); }

input, button, select { width: 100%; padding: 10px; margin: 6px 0px; border: 2px solid rgb(238, 238, 238); border-radius: 10px; box-sizing: border-box; font-size: 14px; }

body.dark input, body.dark select { background: rgb(15, 52, 96); color: white; border-color: rgb(51, 51, 51); }

button { background: linear-gradient(135deg, rgb(79, 172, 254) 0%, rgb(0, 242, 254) 100%); color: white; border-width: medium; border-style: none; border-color: currentcolor; border-image: initial; cursor: pointer; font-weight: 600; }

.btn-aksi { background: rgb(39, 174, 96); width: auto; padding: 8px 15px; margin: 5px; }

.btn-admin { background: rgb(142, 68, 173); width: auto; padding: 8px 15px; margin: 5px; color: white; }

.btn-wa { background: rgb(37, 211, 102); width: auto; padding: 8px 15px; margin: 5px; color: white; }

.btn-danger { background: rgb(231, 76, 60); width: auto; padding: 6px 12px; margin: 3px; color: white; font-size: 12px; }

.btn-dark { position: fixed; top: 20px; right: 20px; width: 50px; height: 50px; border-radius: 50%; font-size: 20px; z-index: 999; }

.login-box { max-width: 400px; margin: auto; }

.admin-panel { border: 2px dashed rgb(142, 68, 173); padding: 15px; border-radius: 10px; margin: 15px 0px; background: rgb(244, 236, 247); }

body.dark.admin-panel { background: rgb(44, 0, 62); }

table { width: 100%; border-collapse: collapse; margin-top: 10px; font-size: 12px; }

th { background: rgb(41, 128, 185); color: white; padding: 8px; }

td { padding: 8px; border-bottom: 1px solid rgb(221, 221, 221); text-align: center; }

body.dark td { border-color: rgb(51, 51, 51); }

.selisih-minus { color: red; font-weight: 700; }

.selisih-plus { color: green; font-weight: 700; }

.user-item { display: flex; justify-content: space-between; align-items: center; padding: 8px; border-bottom: 1px solid rgb(221, 221, 221); }

.rekap-box { margin-top: 20px; padding: 15px; border-radius: 10px; }

.rekap-minus { background: rgb(255, 235, 238); border-left: 5px solid rgb(231, 76, 60); }

.rekap-plus { background: rgb(232, 245, 233); border-left: 5px solid rgb(39, 174, 96); }

body.dark.rekap-minus { background: rgb(62, 31, 31); }

body.dark.rekap-plus { background: rgb(31, 62, 42); }
