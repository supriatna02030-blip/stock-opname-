<!DOCTYPE html><html lang="id"><head><meta http-equiv="Content-Type" content="text/html; charset=UTF-8"><link rel="stylesheet" type="text/css" href="cid:css-f35243da-a9a1-482b-9b66-29039a0c318b@mhtml.blink" />

<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SO PRO V4 - K792/KARBELA2</title>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&amp;display=swap" rel="stylesheet">

</head>
<body>
<button class="btn-dark">🌙</button>

<div class="container">
  <div id="loginPage" class="login-box">
    <h2>🔐 LOGIN SO K792</h2>
    <input type="text" id="inputNIK" placeholder="NIK Karyawan">
    <input type="password" id="inputPIN" placeholder="PIN">
    <button>Login</button>
    <p id="loginError" style="color:red; text-align:center"></p>
  </div>

  <div id="mainApp" style="display:none">
    <h2>☀️ SO PRO K792/KARBELA2 <span id="namaUser"></span></h2>

    <div id="adminPanel" class="admin-panel" style="display:none">
      <h3>⚙️ Panel Admin</h3>
      <input type="text" id="newNIK" placeholder="NIK Baru">
      <input type="text" id="newPIN" placeholder="PIN Baru">
      <input type="text" id="newNama" placeholder="Nama Karyawan">
      <button class="btn-admin">+ Tambah User</button>
      <button class="btn-admin">📋 Lihat Log Login</button>
      <div id="listUser"></div>
      <div id="logLoginAdmin"></div>
    </div>

    <input type="text" id="kodeToko" value="K792/KARBELA2">
    <div style="display:flex; gap:10px">
      <input type="date" id="tanggalOpname">
      <select id="pilihShift">
        <option>SHIFT 1</option><option>SHIFT 2</option><option>SHIFT 3</option>
      </select>
    </div>
    <input type="text" id="namaPIC" placeholder="👤 Nama PIC">
    <input type="text" id="searchBarang" placeholder="🔍 Cari Barang...">

    <div style="display:flex; gap:10px; flex-wrap:wrap; justify-content:center">
      <button class="btn-aksi">📥 Load 43 Item</button>
      <button class="btn-aksi">📋 Ambil OH Shift Sebelumnya</button>
      <button class="btn-aksi">📜 Lihat Riwayat</button>
      <button class="btn-wa">📲 Kirim Rekap Minus WA</button>
      <button class="btn-aksi">💾 Simpan Opname</button>
      <button class="btn-aksi">📤 Export Excel</button>
      <button class="btn-aksi">🚪 Logout</button>
    </div>

    <div id="tabelContainer"></div>
    <div id="rekapSelisih"></div> <!-- REKAP PLUS MINUS DI SINI -->
    <div id="totalStok" style="margin-top:15px; font-weight:700; background:#2980b9; color:white; padding:15px; border-radius:15px; text-align:center"></div>
  </div>
</div>




</body></html>
